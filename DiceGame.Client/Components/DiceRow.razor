@code {
    [Parameter, EditorRequired] public IReadOnlyList<Die> Dice { get; set; } = Array.Empty<Die>();
    [Parameter] public bool CanInteract { get; set; }
    [Parameter] public bool IsRolling { get; set; }
    [Parameter] public EventCallback<int> OnToggleHold { get; set; }

    private static readonly string[] DieFaces = { "⚀", "⚁", "⚂", "⚃", "⚄", "⚅" };

    private string Face(int value) => DieFaces[value - 1];

    private async Task HandleClick(int index)
    {
        if (!CanInteract) return;
        await OnToggleHold.InvokeAsync(index);
    }
}

<div class="dice-row @(IsRolling ? "rolling" : "")">
    @for (var i = 0; i < Dice.Count; i++)
    {
        var index = i;
        var die = Dice[i];
        <button type="button"
                class="die @(die.IsHeld ? "held" : "")"
                disabled="@(!CanInteract)"
                @onclick="() => HandleClick(index)">
            @Face(die.Value)
        </button>
    }
</div>
