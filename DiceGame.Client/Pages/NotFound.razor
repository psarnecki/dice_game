@page "/not-found"
@layout MainLayout

<PageTitle>Nie znaleziono — Kości</PageTitle>

<div class="not-found">
    <h1>404</h1>
    <p>Strona, której szukasz nie istnieje.</p>
    <a href="/">Powrót do menu</a>
</div>

<style>
    .not-found {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: #fff;
        font-family: system-ui, sans-serif;
    }

    .not-found h1 {
        font-size: 5rem;
        margin: 0;
    }

    .not-found a {
        color: #fff;
        text-decoration: underline;
    }
</style>
